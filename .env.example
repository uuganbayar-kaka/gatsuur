# ===== Заавал =====
# Сешн гарын үсгийн нууц (openssl rand -hex 32)
SESSION_SECRET=ee2e355a086f75ec3254d5cc9ddee4e165b4d46f357712ff199b1e8a84a57a2c
# Админ (/admin) — нууц үг 10+ тэмдэгт (openssl rand -base64 18)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Олон админ бол (заавал биш): ADMIN_USERS=admin2:pass2,admin3:pass3
# (Заавал биш) Лог API-г скриптээр татах токен: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=9748e4eed1f02d3dfe9448b8b16c23ed

# Upstash Redis — Vercel → Storage → Upstash for Redis холбоход автоматаар нэмэгдэнэ
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== QPay Merchant (merchant-postman.json) =====
# Эдгээр бүгд бөглөгдсөн үед бодит төлбөр идэвхжинэ. Дутуу бол туршилтын (mock) горим.
# Sandbox: https://merchant-sandbox.qpay.mn
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
# QPay-с олгосон нэхэмжлэхийн код (invoice_code)
QPAY_INVOICE_CODE=

# ===== verify.mn (PIN сэргээх — SMS баталгаажуулалт) =====
# https://verify.mn dashboard-аас авсан API key. Хэзээ ч код руу бичихгүй.
VERIFY_MN_API_KEY=

# Хүчээр туршилтын горимд оруулах бол: PAYMENT_MODE=mock
PAYMENT_MODE=qpay

# Сайтын бүтэн хаяг (QPay callback-д). Хоосон бол Vercel-ийн production домэйн.
NEXT_PUBLIC_BASE_URL=
