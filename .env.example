# ===== Заавал =====
# Сешн гарын үсгийн нууц (openssl rand -hex 32)
SESSION_SECRET=
# Лог харах эрх: /admin/logs?token=<ADMIN_TOKEN>  (openssl rand -hex 16)
ADMIN_TOKEN=

# Upstash Redis — Vercel → Storage → Upstash for Redis холбоход автоматаар нэмэгдэнэ
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== QPay QuickQR (quick-qr-postman.json) =====
# Эдгээр бүгд бөглөгдсөн үед бодит төлбөр идэвхжинэ. Дутуу бол туршилтын (mock) горим.
QPAY_BASE_URL=https://quickqr.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_TERMINAL_ID=
# POST /v2/merchant/company эсвэл /v2/merchant/person-оор үүсгэсэн мерчантын id
QPAY_MERCHANT_ID=
QPAY_MCC_CODE=5812
# Төлбөр орох данс (заавал биш — мерчант дээр тохируулсан бол хоосон үлдээнэ)
QPAY_BANK_CODE=
QPAY_ACCOUNT_NUMBER=
QPAY_ACCOUNT_NAME=

# Хүчээр туршилтын горимд оруулах бол: PAYMENT_MODE=mock
PAYMENT_MODE=

# Сайтын бүтэн хаяг (QPay callback-д). Хоосон бол Vercel-ийн production домэйн.
NEXT_PUBLIC_BASE_URL=
